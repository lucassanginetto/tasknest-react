{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
